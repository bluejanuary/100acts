generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Act {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  category    String
  description String
  photoUrl    String   @map("photo_url")
  photoUrls   String[] @map("photo_urls")
  lat         Float
  long        Float
  gpsAccuracy Float?   @map("gps_accuracy")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("acts")
}
